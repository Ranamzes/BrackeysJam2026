;   param=value ; assign values to parameters

config_version=5

[application]

config/name="BrakaeysJam2026"
run/main_scene="res://root/scenes/UI/main_menu/MainMenu.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
